# Backend
NODE_ENV=development
PORT=8734
HOST=127.0.0.1
DATABASE_PATH=./data/openoverlay.sqlite
UPLOAD_DIR=./data/uploads
MEDIA_GLOBAL_MAX_BYTES=10737418240
STORAGE_MINIMUM_FREE_BYTES=1073741824
LOG_FILE=./data/logs/backend.log
# Intentionally too short for production so copying this file cannot enable a
# known session-signing secret. Generate at least 32 random bytes instead.
JWT_SECRET=replace-me
# Optional override. When empty, a domain-separated key is derived from JWT_SECRET.
SHARE_LOOKUP_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://openoverlay.skylarenns.com
COOKIE_DOMAIN=
GATEWAY_HEALTH_CHECK_INTERVAL_MS=10000
GATEWAY_HEALTH_CHECK_TIMEOUT_MS=2000
GATEWAY_HEALTH_FAILURE_THRESHOLD=3
GATEWAY_PROXY_TIMEOUT_MS=60000
REALTIME_MAX_CONNECTIONS=512
REALTIME_MAX_CONNECTIONS_PER_IP=64
REALTIME_MAX_PAYLOAD_BYTES=65536

# Frontend
VITE_API_BASE_URL=http://localhost:8734
VITE_WS_URL=ws://localhost:8734
